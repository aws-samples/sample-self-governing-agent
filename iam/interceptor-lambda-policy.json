{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SessionBudgetCounter",
      "Effect": "Allow",
      "Action": ["dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:*:*:table/agent-session-budgets"
    },
    {
      "Sid": "InterceptorLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
